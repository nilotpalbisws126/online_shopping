   <script type="text/javascript">
       function pop_register() {
           var url = "/auth.ashx?page=" + document.location.pathname + document.location.search + "&Register=true";
           openFancyboxWithDimenision(url, 421, 825);
       }
       function calltiny() {
           $('.recently_viewed_block .tinyscrl').tinyscrollbar();
       }
       $(window).scroll(function () {
           var toproll = $(document).scrollTop();
           if (toproll < 56) {
               $("#floatmenubar").css({ "top": "56px", "position": "absolute" });
           }
           else {
               $("#floatmenubar").css({ "top": "0px", "position": "fixed" });
           }
       });
       $(document).ready(function () {
           $('#cat1,#cat2,#cat3,#cat4,#cat6,#cat7,#cat11,#cat13,#divrvhtml,#recent_drop ,#cat8, #cat15, #cat16, #cat17,#cat19, cat20').on("mouseenter", function () {
               //alert(this.id);
               $(".tradeattire-mask").remove();
               var ghtml = "<div class='tradeattire-mask' style='height:" + $(document).height() + "px;'></div>";
               $('body').append($(ghtml).hide().fadeIn(100));
           }).on("mouseleave", function () {
               $(".tradeattire-mask").fadeOut(100);
           });
           TargetMantraApi('rvi', 25);
           $('.recently_viewed_block .tinyscrl').tinyscrollbar();
           BindTargetMantraScroll();
           setTimeout('calltiny()', 3000);
           $('#divrvhtml').hover(function () {
               $('#recent_drop').show();
               calltiny();
           },
function () {
    $('#recent_drop').hide();
});
           $("#redirectsubmit").click(function () {
               console.log(countryname);
               setCookieLastLooking("Ctyname", countryname, 30);
               window.location = "http://international.tradeattire.com/index.aspx?uscty=" + countryname;
           });
       });
       var ajax_load = "<div id=\"div-loading_cart\" style=\"position:absolute;background-image:url('http://im6.ybndc.com/UI/template/tradeattire/img/new/white-translayer70.png');text-align:center; width:310px;min-height:90px;top:0px; \"><img src=\"http://im6.ybndc.com/UI/template/tradeattire/img/new/YLoading.gif\" alt=\"loading...\"  style=\"margin-top:20px;\" /></div>";
       function continueshopping() {
           if ($('#blankcart').is(":visible")) {
               $('#blankcart').hide();
               $('#cart_droparrow').hide();
               $('#carticon-main').css({ "background-color": "transparent", "background-image": "url('http://im6.ybndc.com/UI/template/tradeattire/img/sprites3001.png')", "background-position": "-90px 2px" });
               $("#carticon-main").find('#CartValue').css({ "color": "white" });
               $("#carticon-main").find("#Cartchange").css({ "color": "#484848" });
           }
           else {
               $('#blankcart').show();
               $('#cart_droparrow').show();
               $('#carticon-main').css({ "background-image": "url('http://im6.ybndc.com/UI/template/tradeattire/img/new/redcart-main.png')", "background-position": "4px 4px" });
               $("#carticon-main").find('#CartValue').css({ "color": "red" });
               $("#carticon-main").find("#Cartchange").css({ "color": "#ED1B24" });
               //$("#blankcart").fadeOut(1000);
           }
       }
       function headshopcart() {
           var hcount = GetCookie('cart');
           // for Hiding the shopping-cart-empty box
           if (hcount == 0)
               continueshopping();
           if ($('#divminicart').is(":visible")) {
               $('#divminicart').hide();
               $('#cart_droparrow').hide();
               $('#carticon-main').css({ "background-color": "transparent", "background-image": "url('http://im6.ybndc.com/UI/template/tradeattire/img/sprites3001.png')", "background-position": "-90px 2px" });
               $("#carticon-main").find('#CartValue').css({ "color": "white" });
               $("#carticon-main").find("#Cartchange").css({ "color": "#484848" });
           }
           else {
               if (hcount > 0) {
                   $('#cart_droparrow').show();
                   $('#carticon-main').css({ "background-image": "url('http://im6.ybndc.com/UI/template/tradeattire/img/new/redcart-main.png')", "background-position": "4px 4px" });
                   $("#carticon-main").find('#CartValue').css({ "color": "red" });
                   $("#carticon-main").find("#Cartchange").css({ "color": "#ED1B24" });
                   loadcartheader(0);
               }
           }
       }
       function getParameterByName(name) {
           name = name.replace(/[\[]/, "\\\[").replace(/[\]]/, "\\\]");
           var regex = new RegExp("[\\?&]" + name + "=([^&#]*)"),
results = regex.exec(location.search);
           return results == null ? "" : decodeURIComponent(results[1].replace(/\+/g, " "));
       }
       var iscallm = false;
       if (getParameterByName('source') == "footerfullsite") {
           iscallm = true;
           SetCookie('mfullsite', 1);
       }
       if (GetCookie('mfullsite') != 1 && iscallm == false) {
           var url = 'http://m.tradeattire.com';
           url = window.location.href;
           url = url.replace('www.tradeattire.com', 'm.tradeattire.com');
           //alert(url);
           (function (a, b) { if (/(android|bb\d+|meego).+mobile|avantgo|bada\/|blackberry|blazer|compal|elaine|fennec|hiptop|iemobile|ip(hone|od)|iris|kindle|lge |maemo|midp|mmp|netfront|opera m(ob|in)i|palm( os)?|phone|p(ixi|re)\/|plucker|pocket|psp|series(4|6)0|symbian|treo|up\.(browser|link)|vodafone|wap|windows (ce|phone)|xda|xiino/i.test(a) || /1207|6310|6590|3gso|4thp|50[1-6]i|770s|802s|a wa|abac|ac(er|oo|s\-)|ai(ko|rn)|al(av|ca|co)|amoi|an(ex|ny|yw)|aptu|ar(ch|go)|as(te|us)|attw|au(di|\-m|r |s )|avan|be(ck|ll|nq)|bi(lb|rd)|bl(ac|az)|br(e|v)w|bumb|bw\-(n|u)|c55\/|capi|ccwa|cdm\-|cell|chtm|cldc|cmd\-|co(mp|nd)|craw|da(it|ll|ng)|dbte|dc\-s|devi|dica|dmob|do(c|p)o|ds(12|\-d)|el(49|ai)|em(l2|ul)|er(ic|k0)|esl8|ez([4-7]0|os|wa|ze)|fetc|fly(\-|_)|g1 u|g560|gene|gf\-5|g\-mo|go(\.w|od)|gr(ad|un)|haie|hcit|hd\-(m|p|t)|hei\-|hi(pt|ta)|hp( i|ip)|hs\-c|ht(c(\-| |_|a|g|p|s|t)|tp)|hu(aw|tc)|i\-(20|go|ma)|i230|iac( |\-|\/)|ibro|idea|ig01|ikom|im1k|inno|ipaq|iris|ja(t|v)a|jbro|jemu|jigs|kddi|keji|kgt( |\/)|klon|kpt |kwc\-|kyo(c|k)|le(no|xi)|lg( g|\/(k|l|u)|50|54|\-[a-w])|libw|lynx|m1\-w|m3ga|m50\/|ma(te|ui|xo)|mc(01|21|ca)|m\-cr|me(rc|ri)|mi(o8|oa|ts)|mmef|mo(01|02|bi|de|do|t(\-| |o|v)|zz)|mt(50|p1|v )|mwbp|mywa|n10[0-2]|n20[2-3]|n30(0|2)|n50(0|2|5)|n7(0(0|1)|10)|ne((c|m)\-|on|tf|wf|wg|wt)|nok(6|i)|nzph|o2im|op(ti|wv)|oran|owg1|p800|pan(a|d|t)|pdxg|pg(13|\-([1-8]|c))|phil|pire|pl(ay|uc)|pn\-2|po(ck|rt|se)|prox|psio|pt\-g|qa\-a|qc(07|12|21|32|60|\-[2-7]|i\-)|qtek|r380|r600|raks|rim9|ro(ve|zo)|s55\/|sa(ge|ma|mm|ms|ny|va)|sc(01|h\-|oo|p\-)|sdk\/|se(c(\-|0|1)|47|mc|nd|ri)|sgh\-|shar|sie(\-|m)|sk\-0|sl(45|id)|sm(al|ar|b3|it|t5)|so(ft|ny)|sp(01|h\-|v\-|v )|sy(01|mb)|t2(18|50)|t6(00|10|18)|ta(gt|lk)|tcl\-|tdg\-|tel(i|m)|tim\-|t\-mo|to(pl|sh)|ts(70|m\-|m3|m5)|tx\-9|up(\.b|g1|si)|utst|v400|v750|veri|vi(rg|te)|vk(40|5[0-3]|\-v)|vm40|voda|vulc|vx(52|53|60|61|70|80|81|83|85|98)|w3c(\-| )|webc|whit|wi(g |nc|nw)|wmlb|wonu|x700|yas\-|your|zeto|zte\-/i.test(a.substr(0, 4))) window.location = b })
(navigator.userAgent || navigator.vendor || window.opera, url);
       }
</script>
